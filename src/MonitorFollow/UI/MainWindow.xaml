<ui:FluentWindow
    x:Class="MonitorFollow.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MonitorFollow"
    Width="580" Height="760" MinWidth="520" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="MonitorFollow" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel Margin="0,8,0,16">

                <!-- Hero / status -->
                <ui:Card Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12" Margin="0,0,16,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Image x:Name="HeroIcon" Width="34" Height="34" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" Fill="#3A96DD" VerticalAlignment="Center" />
                                <ui:TextBlock x:Name="StatusText" FontTypography="Subtitle" Text="Starting…" />
                            </StackPanel>
                            <ui:TextBlock x:Name="StatusDetail" Appearance="Secondary" Text=" " Margin="18,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button x:Name="PauseButton" Grid.Column="2" Content="Pause" Icon="{ui:SymbolIcon Pause24}" Appearance="Secondary"
                                   VerticalAlignment="Center" Click="Pause_Click" />
                    </Grid>
                </ui:Card>

                <!-- Monitor -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Monitor to follow" Margin="4,0,0,8" />
                <ui:Card Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonitorCombo" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="MonitorCombo_SelectionChanged" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Detect monitors again" Click="Refresh_Click" />
                        </Grid>
                        <ui:TextBlock x:Name="MonitorInfo" Appearance="Secondary" Margin="2,10,0,0" TextWrapping="Wrap"
                                      Text="The monitor whose physical power button drives the other screens. Only monitors answering DDC/CI power queries are listed." />
                    </StackPanel>
                </ui:Card>

                <!-- Behaviour -->
                <ui:TextBlock FontTypography="BodyStrong" Text="Behaviour" Margin="4,0,0,8" />
                <StackPanel Margin="0,0,0,16">
                    <ui:CardControl Icon="{ui:SymbolIcon WindowApps24}" Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Restore window positions" />
                                <ui:TextBlock Appearance="Secondary" Text="Put windows back on the other screens when they return" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="RestoreToggle" />
                    </ui:CardControl>

                    <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Notifications" />
                                <ui:TextBlock Appearance="Secondary" Text="Show a toast every time the screens switch" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="NotifyToggle" />
                    </ui:CardControl>

                    <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Emergency hotkey" />
                                <ui:TextBlock Appearance="Secondary" Text="Ctrl+Alt+Shift+E restores all screens, from anywhere" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="HotkeyToggle" />
                    </ui:CardControl>

                    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Start with Windows" />
                                <ui:TextBlock Appearance="Secondary" Text="Per-user startup entry, no admin rights needed" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="StartupToggle" />
                    </ui:CardControl>

                    <ui:CardExpander Icon="{ui:SymbolIcon Settings24}" Margin="0,0,0,4">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Advanced" />
                                <ui:TextBlock Appearance="Secondary" Text="Polling interval and debounce" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="Poll interval (ms)" />
                                    <ui:TextBlock Appearance="Secondary" Text="How often the monitor is asked for its power state" />
                                </StackPanel>
                                <ui:NumberBox x:Name="IntervalBox" Grid.Column="1" Minimum="250" Maximum="10000" SmallChange="250" LargeChange="1000" ClearButtonEnabled="False" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="Consecutive 'off' readings" />
                                    <ui:TextBlock Appearance="Secondary" Text="Debounce: one glitchy reading won't switch your screens" />
                                </StackPanel>
                                <ui:NumberBox x:Name="DebounceBox" Grid.Column="1" Minimum="1" Maximum="10" SmallChange="1" ClearButtonEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>

                <!-- How it works -->
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="How it works" Margin="0,0,0,16"
                            Message="Power button OFF → Windows switches to “Second screen only” (like Win+P). Power button ON → back to “Extend”, windows restored. The monitor is only ever read, never written, and no screen is put to sleep, so you can't get stuck. Stuck anyway? Ctrl+Alt+Shift+E, or Win+P → Extend." />

                <!-- Activity -->
                <Grid Margin="4,0,0,8">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Activity" />
                    <ui:HyperlinkButton Content="Open log file" HorizontalAlignment="Right" Padding="4,0" Click="OpenLog_Click" />
                </Grid>
                <ui:Card Padding="0" Margin="0,0,0,8">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="160"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" />
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Restore all screens" Icon="{ui:SymbolIcon DesktopArrowRight24}" Click="ForceExtend_Click" />
                <ui:TextBlock x:Name="SavedText" Grid.Column="1" Appearance="Secondary" VerticalAlignment="Center" Margin="12,0" Text="" />
                <ui:HyperlinkButton Grid.Column="2" Content="About" Click="About_Click" Margin="0,0,8,0" />
                <ui:Button Grid.Column="3" Content="Save" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
